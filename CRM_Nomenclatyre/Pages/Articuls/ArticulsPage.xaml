<Page x:Class="CRM_Nomenclatyre.Pages.ArticulsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CRM_Nomenclatyre.Pages"
      mc:Ignorable="d" Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ArticulsPage">

    <Grid>
        <!--#region -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->
        <DataGrid x:Name="dg_artList" 
                  Grid.Column="1" Grid.Row="1"
                  CanUserAddRows="False" CanUserDeleteRows="False" 
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListArticules}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Named}"/>
                <DataGridTextColumn Header="Номенклатура" Binding="{Binding Articul}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding Sort}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Count}"/>
                <DataGridTextColumn Header="Баркод" Binding="{Binding Barcod}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Добавить" Command="{Binding AddTovar}"
                Grid.Column="1"  
                HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
</Page>
