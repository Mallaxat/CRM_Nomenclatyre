<Page x:Class="CRM_Nomenclatyre.Pages.ArticulsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CRM_Nomenclatyre.Pages"
      mc:Ignorable="d" Background="#2b3b4c"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ArticulsPage">
    <Page.Resources>
        <CollectionViewSource x:Key="TypeListSource"
                          Source="{Binding TypeList}" />

    </Page.Resources>

    <Grid Unloaded="Grid_Unloaded">
        <!--#region -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>

        </Grid.RowDefinitions>
        <!--#endregion-->

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            
            <Button x:Name="bt_filtrend" Grid.Column="2" Grid.Row="3"
                    Content="Снять фильтр" 
                    Command="{Binding cFilterDelete}" Click="Button_Click_2"
                
                    FontWeight="SemiBold"
                    FontSize="20"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Margin="5,0,5,5"/>

            <Button x:Name="bt_filtr"  
                    Grid.Column="2" Grid.Row="1"
                    Content="Фильтровать"
                    Command="{Binding cFilterAdd}" Click="Button_Click_1"
                    FontWeight="SemiBold"
                    FontSize="20"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Margin="5,0,5,5"/>

            <Button x:Name="bt_update" 
                    Grid.Column="0" Grid.Row="2"
                    Content="Обновить" Command="{Binding cUpdate}" Click="Button_Click"
                    FontWeight="SemiBold"
                    FontSize="20"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Margin="5,0,5,5"/>

            <ComboBox Grid.Column="13" Grid.Row="1"
                      ItemsSource="{Binding Source={StaticResource TypeListSource}}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding FilterIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      FontWeight="SemiBold"
                      FontSize="20"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                      Margin="5,0,5,5"
                  />

        </Grid>

        <DataGrid x:Name="dg_artList" 
                  Grid.Column="1" Grid.Row="1"
                  CanUserAddRows="True" CanUserDeleteRows="True" 
                  ItemsSource="{Binding ListDataTable}"
                  AutoGenerateColumns="False"
                  
                  CanUserResizeColumns="False"
                  ColumnWidth="*"  
                  FontWeight="SemiBold" FontSize="20">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Код" Binding="{Binding ManagerId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Visibility="Collapsed"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Named , UpdateSourceTrigger=PropertyChanged}"/>
   
    
                <DataGridTextColumn Header="Номенклатура" Binding="{Binding Articul, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                <DataGridComboBoxColumn Header="Товар"
                                        ItemsSource="{Binding Source={StaticResource TypeListSource}}"
                                        DisplayMemberPath="Name"
                                        SelectedValuePath="Id"
                                        SelectedValueBinding="{Binding [TypeTovarID], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <DataGridTextColumn Header="Размер" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Count, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Баркод" Binding="{Binding Barcod, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>





    </Grid>
</Page>
