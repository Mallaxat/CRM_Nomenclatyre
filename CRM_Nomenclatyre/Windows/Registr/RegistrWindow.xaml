<Window x:Class="CRM_Nomenclatyre.Windows.Registr.RegistrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRM_Nomenclatyre.Windows.Registr"
        mc:Ignorable="d"
        Title="RegistrWindow" Height="250" Width="200">
    <Grid>
        <!--#region -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->
        <Label Content="Имя" 
              Grid.Column="1" Grid.Row="0"
              HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox x:Name="tb_FirstName" Text="{Binding FirstName}"
              Grid.Column="2" Grid.Row="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        
        <Label Content="Фамилия" 
              Grid.Column="1" Grid.Row="1"
              HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox x:Name="tb_LasttName" Text="{Binding LastName}"
              Grid.Column="2" Grid.Row="1"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

        <Label Content="Логин" 
               Grid.Column="1" Grid.Row="2"
               HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox x:Name="tb_Login" Text="{Binding Login}"
               Grid.Column="2" Grid.Row="2"
               HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
       
        <Label Content="Пароль" 
               Grid.Column="1" Grid.Row="3"
               HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox x:Name="tb_Password" Text="{Binding Password}"
               Grid.Column="2" Grid.Row="3"
               HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        <Button x:Name="bt_Reg" Content="Регистрация" 
                 Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Command="{Binding cAddUser}"/>



    </Grid>
</Window>
