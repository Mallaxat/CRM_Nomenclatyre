<Window x:Class="CRM_Nomenclatyre.Windows.Registr.RegistrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRM_Nomenclatyre.Windows.Registr"
        mc:Ignorable="d"
        Title="Регистрация" MinHeight="400" MinWidth="500" 
        Background="#2b3b4c" SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Windows/Login/Main_icon.png">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Style/LabelWhiteStyle.xaml"/>
                <ResourceDictionary Source="/Assets/Style/ButtonBlueStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Grid>
        <!--#region -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->

        <Grid Grid.Column="1" Grid.Row="1" >
            <!--#region -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <!--#endregion-->


            <Label Content="Имя" 
                  Grid.Column="0" Grid.Row="1"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" 
                  Style="{StaticResource LabelStyleWhite}"/>

            <TextBox x:Name="tb_FirstName" Text="{Binding FirstName }"
                  Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="3"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  FontSize="24"
                  Margin="5,10,5,10"/>
        
            <Label Content="Фамилия" 
                  Grid.Column="0" Grid.Row="3"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Style="{StaticResource LabelStyleWhite}"/>
            <TextBox x:Name="tb_LasttName" Text="{Binding LastName}"
                  Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  FontSize="24"
                  Margin="5,10,5,10"/>

            <Label Content="Логин" 
                   Grid.Column="0" Grid.Row="5"                   
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Style="{StaticResource LabelStyleWhite}"/>
            <TextBox x:Name="tb_Login" Text="{Binding Login}"
                   Grid.Column="2" Grid.Row="5"    Grid.ColumnSpan="3"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   FontSize="24"
                   Margin="5,10,5,10"/>
       
            <Label Content="Пароль" 
                   Grid.Column="0" Grid.Row="7"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Style="{StaticResource LabelStyleWhite}"/>
            <TextBox x:Name="tb_Password" Text="{Binding Password}"
                   Grid.Column="2" Grid.Row="7" Grid.ColumnSpan="3"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   FontSize="24"
                   Margin="5,10,5,10"/>

            <Button x:Name="bt_Reg" Content="Регистрация" 
                   Grid.Column="0" Grid.Row="9" Grid.ColumnSpan="4"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                   Style="{StaticResource ButtonBlueStyle}"
                   Margin="5,5,5,5"
                   Command="{Binding cRegistration}" Click="bt_Reg_Click"/>


        </Grid>
    </Grid>
</Window>
