<Window x:Class="CRM_Nomenclatyre.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRM_Nomenclatyre.Windows"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>
        <!--#region -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>

            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>

            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->

        <StackPanel Grid.Row="1" Grid.Column="1" 
                    HorizontalAlignment="Left" VerticalAlignment="Top">
            <Label  Content="Логин"/>
            <Label Content="Пароль
                   "/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" 
                  HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBox x:Name="text_Login" Grid.Column="1"
                 TextWrapping="Wrap" Text="{Binding Login}" />
            <PasswordBox x:Name="text_Password" Password="1"/>
        </StackPanel>

       
        <StackPanel Grid.Row="1" Grid.Column="1" 
                    HorizontalAlignment="Center" VerticalAlignment="Bottom">

            <Button Content="Регистрация" x:Name="bt_registration"
                Command="{Binding cRegistration}"/>

            <Button Content="Вход" x:Name="bt_login"
                Command="{Binding cLogin}" Click="bt_login_Click"/>
        </StackPanel>


    </Grid>
</Window>
