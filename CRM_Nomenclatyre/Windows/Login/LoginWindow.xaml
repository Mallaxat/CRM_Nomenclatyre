<Window x:Class="CRM_Nomenclatyre.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRM_Nomenclatyre.Windows"
        mc:Ignorable="d"
        Title="Вход" MinHeight="500" MinWidth="500"
        Background="#2b3b4c" SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Windows/Login/Main_icon.png">
    <Grid>
        <!--#region -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <!--#endregion-->


        <Grid Grid.Column="1" Grid.Row="1" >
            <!--#region -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <!--#endregion-->

            <Label  Content="Логин"
                    Grid.Column="0" Grid.Row="1" 
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" 
                    FontFamily="Bahnschrift" FontWeight="SemiBold" 
                    Foreground="White" FontSize="24"/>
            <TextBox x:Name="text_Login" 
                    Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" 
                    TextWrapping="Wrap" Margin="5,10,5,10"
                    Text="{Binding Login}" FontSize="24" />


            <Label Content="Пароль"                   
                    Grid.Column="0" Grid.Row="3" 
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                    FontFamily="Bahnschrift" FontWeight="SemiBold"
                    FontSize="24"
                    Foreground="White"/>
            
            <PasswordBox x:Name="text_Password" 
                    Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Margin="5,10,5,10" FontSize="24"/>

            <Button Content="Регистрация" x:Name="bt_registration" 
                    Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="5" 
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    FontFamily="Bahnschrift" FontWeight="SemiBold"  
                    Foreground="#212e3c" Margin="5,0,5,0"
                    FontSize="24"
                    Command="{Binding cRegistration}"/>
            
            <Button Content="Вход" x:Name="bt_login"
                    Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="7" 
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    FontFamily="Bahnschrift" FontWeight="SemiBold"  
                    Foreground="#212e3c" Margin="5,0,5,0"
                    FontSize="24"
                    Command="{Binding cLogin}" Click="bt_login_Click"/>
 
        </Grid>

    </Grid>
</Window>
